{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    { "src": "api/proxy/[...path].mjs", "use": "@vercel/node" },
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "manifest.json", "use": "@vercel/static" },
    { "src": "robots.txt", "use": "@vercel/static" },
    { "src": "service-worker.js", "use": "@vercel/static" },
    { "src": "VERSION.txt", "use": "@vercel/static" },
    { "src": "css/**", "use": "@vercel/static" },
    { "src": "image/**", "use": "@vercel/static" },
    { "src": "js/**", "use": "@vercel/static" },
    { "src": "libs/**", "use": "@vercel/static" }
  ],
  "rewrites": [
    {
      "source": "/proxy/:path*",
      "destination": "/api/proxy/:path*"
    },
    {
      "source": "/s=:query",
      "destination": "/index.html"
    },
    {
      "source": "/player.html/:path*",
      "destination": "/player.html"
    }
  ]
}
